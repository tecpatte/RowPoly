# Root env for docker compose. Copy to .env and adjust.
POSTGRES_USER=rowpoly
POSTGRES_PASSWORD=rowpoly
POSTGRES_DB=rowpoly

JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_too_another_random_string

# Where the browser reaches the backend.
PUBLIC_API_URL=http://localhost:3001/api
PUBLIC_WS_URL=http://localhost:3001

# Allowed frontend origin for CORS / websockets.
CORS_ORIGIN=http://localhost:4321
